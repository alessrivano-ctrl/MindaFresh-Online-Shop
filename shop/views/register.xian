{{> head}}
{{> shop-nav}}

<main class="mx-auto flex w-full max-w-xl flex-col gap-5 px-6 pb-14 pt-10">
  <form action="/register" method="POST" class="card flex flex-col gap-4 p-8">
    <div class="flex flex-col gap-1">
      <h1 class="text-[28px] font-extrabold tracking-tight">Create your account</h1>
      <p class="text-[15px] text-ink-muted">Order fresh food for delivery in Calapan City.</p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3.5">
      <div class="flex flex-col gap-1.5">
        <label for="first_name" class="label">First name</label>
        <input id="first_name" name="first_name" value="{{form.first_name}}" autocomplete="given-name" required maxlength="50" class="field">
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="last_name" class="label">Last name</label>
        <input id="last_name" name="last_name" value="{{form.last_name}}" autocomplete="family-name" required maxlength="50" class="field">
      </div>
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="email" class="label">Email</label>
      <input id="email" name="email" type="email" value="{{form.email}}" autocomplete="email" required maxlength="100" class="field">
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="phone" class="label">Mobile number <span class="font-normal text-ink-muted">(optional)</span></label>
      <input id="phone" name="phone" type="tel" value="{{form.phone}}" placeholder="09171234567" pattern="09[0-9]{9}" title="11 digits, starting with 09" class="field">
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3.5">
      <div class="flex flex-col gap-1.5">
        <label for="address" class="label">Address <span class="font-normal text-ink-muted">(optional)</span></label>
        <input id="address" name="address" value="{{form.address}}" placeholder="House no., street, barangay" maxlength="200" class="field">
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="city" class="label">City</label>
        <input id="city" name="city" value="{{#if form.city}}{{form.city}}{{else}}Calapan City{{/if}}" maxlength="100" class="field">
      </div>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-3.5">
      <div class="flex flex-col gap-1.5">
        <label for="password" class="label">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" class="field">
        <span class="text-[13px] text-ink-muted">At least 8 characters</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="confirm_password" class="label">Confirm password</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required minlength="8" class="field">
      </div>
    </div>
    <button type="submit" class="btn-primary min-h-[50px] text-base">Create account</button>
    <p class="text-center text-sm text-ink-muted">Already have an account? <a href="/login" class="font-bold">Log in</a></p>
  </form>
</main>

{{> alert/alert}}
{{> footer}}
