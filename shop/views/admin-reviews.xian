{{> head}}
{{> admin-nav}}

<div class="mx-auto flex w-full max-w-[1440px] gap-6 p-6 lg:p-9">

  <main class="flex min-w-0 flex-1 flex-col gap-5">
    <div class="flex flex-col gap-1">
      <h1 class="text-[32px] font-extrabold tracking-tight">Reviews</h1>
      <p class="text-sm text-ink-muted">Only customers whose order was delivered can review a product. Hide a review that is rude or not about the product; hidden reviews are kept but not shown in the shop.</p>
    </div>

    <nav aria-label="Filter by status" class="flex flex-wrap gap-1.5">
      <a href="/admin/reviews" {{#unless status}}aria-current="true"{{/unless}} class="inline-flex min-h-[36px] items-center gap-1.5 rounded-full border px-3.5 text-[13px] font-bold {{#unless status}}border-ink bg-ink text-white{{else}}border-line-strong bg-white text-ink hover:bg-peach-soft{{/unless}}">All <span class="{{#unless status}}text-peach{{else}}text-ink-muted{{/unless}}">{{counts.all}}</span></a>
      <a href="/admin/reviews?status=visible" {{#if (eq status "visible")}}aria-current="true"{{/if}} class="inline-flex min-h-[36px] items-center gap-1.5 rounded-full border px-3.5 text-[13px] font-bold {{#if (eq status "visible")}}border-ink bg-ink text-white{{else}}border-line-strong bg-white text-ink hover:bg-peach-soft{{/if}}">Visible <span class="{{#if (eq status "visible")}}text-peach{{else}}text-ink-muted{{/if}}">{{counts.visible}}</span></a>
      <a href="/admin/reviews?status=hidden" {{#if (eq status "hidden")}}aria-current="true"{{/if}} class="inline-flex min-h-[36px] items-center gap-1.5 rounded-full border px-3.5 text-[13px] font-bold {{#if (eq status "hidden")}}border-ink bg-ink text-white{{else}}border-line-strong bg-white text-ink hover:bg-peach-soft{{/if}}">Hidden <span class="{{#if (eq status "hidden")}}text-peach{{else}}text-ink-muted{{/if}}">{{counts.hidden}}</span></a>
    </nav>

    <div class="card overflow-x-auto rounded-[18px]">
      <table class="w-full min-w-[900px] border-collapse text-sm">
        <thead>
          <tr class="bg-peach-soft text-left">
            <th scope="col" class="px-4 py-3 font-bold">Product</th>
            <th scope="col" class="px-4 py-3 font-bold">Customer</th>
            <th scope="col" class="px-4 py-3 font-bold">Rating</th>
            <th scope="col" class="px-4 py-3 font-bold">Review</th>
            <th scope="col" class="px-4 py-3 font-bold">Status</th>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody>
          {{#each reviews}}
          <tr class="border-t border-[#F6EADD] align-top">
            <td class="px-4 py-3"><div class="font-bold">{{product_name}}</div><div class="text-xs text-ink-muted">{{product_code}}</div></td>
            <td class="px-4 py-3"><div class="font-semibold">{{customer_name}}</div><div class="text-xs text-ink-muted">{{customer_code}} · {{order_code}}</div></td>
            <td class="whitespace-nowrap px-4 py-3"><span class="tracking-wider text-[#E8A317]" aria-label="{{rating}} out of 5 stars">{{stars rating}}</span></td>
            <td class="max-w-[420px] px-4 py-3"><p class="text-ink-soft">{{#if comment}}{{comment}}{{else}}<span class="text-ink-muted">(no comment)</span>{{/if}}</p><div class="pt-1 text-xs text-ink-muted">{{datetime date}}</div></td>
            <td class="px-4 py-3">{{#if (eq status "visible")}}<span class="badge bg-leaf-bg text-[#2F4A12]">Visible</span>{{else}}<span class="badge bg-[#F3E9DF] text-ink-soft">Hidden</span>{{/if}}</td>
            <td class="px-4 py-3 text-right">
              {{#if (eq status "visible")}}
              <form action="/admin/reviews/{{id}}/status{{#if ../status}}?status={{../status}}{{/if}}" method="POST" data-confirm="Hide this review of {{product_name}}?" data-confirm-text="Customers will no longer see it. You can show it again later." data-confirm-button="Yes, hide it">
                <input type="hidden" name="status" value="hidden">
                <button type="submit" class="btn-outline min-h-[36px] px-3.5 text-sm">Hide</button>
              </form>
              {{else}}
              <form action="/admin/reviews/{{id}}/status{{#if ../status}}?status={{../status}}{{/if}}" method="POST">
                <input type="hidden" name="status" value="visible">
                <button type="submit" class="btn-dark min-h-[36px] px-3.5 text-sm">Show</button>
              </form>
              {{/if}}
            </td>
          </tr>
          {{else}}
          <tr><td colspan="6" class="px-4 py-8 text-center text-ink-muted">No reviews yet.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </main>
</div>

{{> alert/alert}}
{{> admin-footer}}
