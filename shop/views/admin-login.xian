{{> head}}
<header class="bg-ink text-white">
  <div class="flex items-center gap-2.5 px-6 py-3">
    <img src="/images/freshcart-logo.png" alt="" width="40" height="40" class="h-9 w-9 shrink-0">
    <span class="text-[17px] font-extrabold">FreshCart Admin</span>
  </div>
</header>

<main class="mx-auto flex w-full max-w-md flex-col gap-5 px-6 pb-14 pt-12">
  <form action="/admin/login" method="POST" class="card flex flex-col gap-4 p-8">
    <div class="flex flex-col gap-1">
      <h1 class="text-[28px] font-extrabold tracking-tight">Staff log in</h1>
      <p class="text-[15px] text-ink-muted">Use the same username and password as the other MindaFresh modules.</p>
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="username" class="label">Username</label>
      <input id="username" name="username" autocomplete="username" required class="field">
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="password" class="label">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required class="field">
    </div>
    <button type="submit" class="btn-dark min-h-[50px] text-base">Log in</button>
  </form>
  <p class="text-center text-sm text-ink-muted"><a href="/" class="font-semibold">← Back to the shop</a></p>
</main>

{{> alert/alert}}
{{> footer}}
