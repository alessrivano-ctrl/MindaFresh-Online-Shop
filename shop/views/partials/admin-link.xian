<a href="{{href}}" {{#if (eq nav key)}}aria-current="page" class="flex min-h-[48px] items-center gap-3 rounded-xl bg-brand px-4 text-[16px] font-bold text-white"{{else}}class="flex min-h-[48px] items-center gap-3 rounded-xl px-4 text-[16px] font-semibold text-[#F3DCC8] hover:bg-white/10 hover:text-white"{{/if}}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
    {{#if (eq icon "dashboard")}}<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>{{/if}}
    {{#if (eq icon "orders")}}<path d="M6 2h12l2 4v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6z"/><path d="M4 6h16"/><path d="M9 11h6M9 15h6"/>{{/if}}
    {{#if (eq icon "report")}}<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>{{/if}}
    {{#if (eq icon "photo")}}<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>{{/if}}
    {{#if (eq icon "reviews")}}<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>{{/if}}
    {{#if (eq icon "customers")}}<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.8 3 2.5 3.5 5.2"/>{{/if}}
    {{#if (eq icon "shop")}}<path d="M3 9l1.5-5h15L21 9"/><path d="M4 9v11h16V9"/><path d="M3 9h18"/><path d="M10 20v-6h4v6"/>{{/if}}
  </svg>
  {{label}}
</a>
