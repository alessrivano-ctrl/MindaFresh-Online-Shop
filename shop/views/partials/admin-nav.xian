<header class="bg-ink text-white">
  <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-3">
    <a href="/admin/orders" class="flex items-center gap-2.5 text-white no-underline">
      <img src="/images/freshcart-logo.png" alt="" width="40" height="40" class="h-9 w-9 shrink-0">
      <span class="text-[17px] font-extrabold">FreshCart Admin</span>
    </a>
    <div class="flex items-center gap-4 text-sm">
      <span class="text-[#F3DCC8]">{{staff.full_name}} · {{staff.employee_code}} · <strong class="text-white">{{staff.role}}</strong></span>
      <a href="/" class="flex min-h-[44px] items-center font-semibold text-[#F3DCC8] hover:text-white">View shop</a>
      <a href="/admin/logout" class="flex min-h-[44px] items-center font-semibold text-white">Log out</a>
    </div>
  </div>
</header>
