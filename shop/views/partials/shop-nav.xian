<header class="border-b border-line bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-6 py-3.5">
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 4 13c0-5 4-9 16-9 0 12-4 16-9 16Z"/><path d="M4 20c4-4 7-6 11-8"/></svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-xl font-extrabold tracking-tight">FreshCart</span>
        <span class="text-xs font-medium text-ink-muted">by MindaFresh</span>
      </span>
    </a>

    <form action="/" method="GET" class="flex min-h-[44px] flex-1 basis-72 items-center gap-2 rounded-xl border border-line-strong bg-peach-soft pl-3.5 pr-1.5">
      <label for="q" class="sr-only">Search products</label>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B4F3F" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" name="q" type="search" value="{{q}}" placeholder="Search calamansi, bangus, rice…" class="min-w-0 flex-1 border-0 bg-transparent py-2.5 text-[15px] outline-none">
      <button type="submit" class="min-h-[34px] rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-dark">Search</button>
    </form>

    <nav aria-label="Account" class="flex flex-wrap items-center gap-1 whitespace-nowrap text-sm font-semibold">
      {{#if customer}}
        <a href="/orders" class="flex min-h-[44px] items-center rounded-lg px-3 hover:bg-peach-soft">My orders</a>
      {{/if}}
      <a href="/cart" class="flex min-h-[44px] items-center gap-2 rounded-lg px-3 hover:bg-peach-soft">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21.5 8H6"/></svg>
        Cart
        <span class="rounded-full bg-ink px-2 py-0.5 text-xs font-bold text-white">{{cartCount}}</span>
      </a>
      {{#if customer}}
        <span class="flex min-h-[44px] items-center gap-2 px-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-peach text-xs font-bold text-brand-dark">{{customer.initials}}</span>
          {{customer.first_name}}
        </span>
        <a href="/logout" class="flex min-h-[44px] items-center rounded-lg px-3 text-ink-muted hover:bg-peach-soft">Log out</a>
      {{else}}
        <a href="/login" class="flex min-h-[44px] items-center rounded-lg px-3 hover:bg-peach-soft">Log in</a>
        <a href="/register" class="btn-primary min-h-[40px] px-4 text-sm">Sign up</a>
      {{/if}}
    </nav>
  </div>
</header>
