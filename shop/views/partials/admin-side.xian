    <a href="/admin/products" {{#if (eq nav "products")}}aria-current="page" class="flex min-h-[44px] items-center rounded-[10px] bg-peach px-3.5 text-[15px] font-bold text-brand-dark"{{else}}class="flex min-h-[44px] items-center rounded-[10px] px-3.5 text-[15px] font-semibold hover:bg-peach-soft"{{/if}}>Online products</a>
  {{/if}}
