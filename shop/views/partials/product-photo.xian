{{!-- Product image, or a tinted placeholder when products.image_url is empty. Pass height class as h. --}}
{{#if image_url}}
  <img src="{{image_url}}" alt="{{name}}" class="{{h}} w-full object-cover">
{{else}}
  <div class="{{h}} flex w-full flex-col items-center justify-center gap-2 text-ink-soft" style="background: {{tint category}}">
    <svg width="{{#if small}}24{{else}}34{{/if}}" height="{{#if small}}24{{else}}34{{/if}}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
    {{#unless small}}<span class="text-xs font-semibold">{{category}}</span>{{/unless}}
  </div>
{{/if}}
