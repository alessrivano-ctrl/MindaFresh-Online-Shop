{{> head}}
{{> shop-nav}}

<main class="mx-auto flex w-full max-w-md flex-col gap-5 px-6 pb-14 pt-10">
  {{> flash}}
  <form action="/login" method="POST" class="card flex flex-col gap-4 p-8">
    <div class="flex flex-col gap-1">
      <h1 class="text-[28px] font-extrabold tracking-tight">Log in</h1>
      <p class="text-[15px] text-ink-muted">Welcome back to FreshCart.</p>
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="email" class="label">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required class="field">
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="password" class="label">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required class="field">
    </div>
    <button type="submit" class="btn-primary min-h-[50px] text-base">Log in</button>
    <p class="text-center text-sm text-ink-muted">New here? <a href="/register" class="font-bold">Create an account</a></p>
  </form>
  <p class="text-center text-sm text-ink-muted">MindaFresh staff? <a href="/admin/login" class="font-semibold">Staff log in</a></p>
</main>

{{> footer}}
