{
  "name": "shop",
  "version": "1.0.0",
  "description": "MindaFresh ERP — Online Shop (XianFire)",
  "main": "index.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "create:add-middleware": "node create.js middleware",
    "create:upload-middleware": "node create.js upload-middleware",
    "route:list": "node list-routes.js",
    "route:cache": "node route-cache.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --watch"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "multer": "^2.0.2",
    "mysql2": "^3.9.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.17"
  }
}
