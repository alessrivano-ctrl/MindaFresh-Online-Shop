# --- shop/.env  (copy this file to .env and fill in) ---
PORT=3001
APP_NAME="MindaFresh Online Shop"
APP_URL=http://192.168.1.11:3001
TZ=Asia/Manila
SESSION_SECRET=shop-session-secret-change-me

# --- shared by all 5 modules ---
DB_HOST=127.0.0.1             # the DB host's IP in LAN mode (127.0.0.1 in solo mode)
DB_PORT=3306
DB_NAME=mindafresh_db
DB_USER=mindafresh
DB_PASS=MindaFresh@2026

# --- Shop only ---
SHIPPING_FEE=50               # flat delivery fee in pesos, posted to 4030 Delivery Fee Income
STAFF_LOGIN_PATH=/admin/login # where requireRole sends staff who are not logged in
